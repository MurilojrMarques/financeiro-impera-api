# ── Aplicação ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origens permitidas (CSV). Em produção NÃO use "*".
CORS_ORIGINS=http://localhost:5173
# Proxies confiáveis à frente da API (1 com Nginx/Caddy). Necessário para IP real no rate limit.
TRUST_PROXY=0
# Habilita /docs em produção somente com true (exige autenticação ADMIN)
SWAGGER_ENABLED=true

# ── Banco ──
DATABASE_URL=postgresql://financeiro:troque_esta_senha@localhost:5432/financeiro?schema=public
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=financeiro

# ── Auth (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ──
JWT_ACCESS_SECRET=
JWT_ISSUER=financeiro-impera-api
JWT_AUDIENCE=financeiro-impera-dashboard
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Cookie do refresh token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── Google Sheets (somente leitura, via Service Account) ──
# Opção A: caminho do JSON (fora do Git, ex.: ./secrets/google-sa.json)
GOOGLE_APPLICATION_CREDENTIALS=
# Opção B: JSON da credencial em base64 (útil em VPS/containers)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SHEET_ID=
SHEET_TAB_HISTORICO=HISTORICO
SHEET_TAB_EVENTOS=EVENTOS
SHEET_TAB_REDTRACK=REDTRACK
GOOGLE_TIMEOUT_MS=30000
SHEETS_BATCH_SIZE=1000
SHEETS_MAX_RETRIES=5
# Extensão opcional do mapeamento de cabeçalhos: {"HISTORICO":{"atendente":["operador_cc"]}}
SHEET_HEADER_ALIASES_JSON=
# Linhas relidas antes do cursor a cada sync incremental (detecta comissões corrigidas)
SYNC_LOOKBACK_ROWS=500

# ── Sincronização (worker) ──
SYNC_ENABLED=true
SYNC_EVENTOS_INTERVAL_SECONDS=60
SYNC_REDTRACK_INTERVAL_SECONDS=1800
# Reconciliação completa diária (hora local America/Sao_Paulo, HH:mm)
SYNC_RECONCILE_TIME=03:30
# Dados são considerados desatualizados após N segundos sem sync de EVENTOS
STALE_AFTER_SECONDS=300

# ── Uploads (armazenamento privado, fora de qualquer pasta pública) ──
UPLOAD_DIR=./storage/anexos
UPLOAD_MAX_BYTES=5242880

# ── Rate limit ──
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_MAX=300

# ── Bootstrap do primeiro admin (usado só por `npm run bootstrap:admin`) ──
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
# Senha temporária: informe via ambiente só no momento do comando; troca obrigatória no 1º login.
BOOTSTRAP_ADMIN_PASSWORD=

# Investimento em anúncios (RedTrack). Opcional; sem a chave, ROAS/Sobra do tráfego aparecem como indisponíveis.
# REDTRACK_API_KEY=
# REDTRACK_OFFER_FILTER=pagah

# ── RH: leitura do sistema atual (MySQL impera_rh na VPS, via túnel SSH). SOMENTE LEITURA. Preencha no .env local, nunca no Git. ──
RH_SSH_HOST=
RH_SSH_PORT=22
RH_SSH_USER=
# use UMA das duas formas de autenticação SSH:
RH_SSH_PASSWORD=
RH_SSH_KEY_PATH=
RH_SSH_KEY_PASSPHRASE=
# impressão digital SHA256 (hex) do servidor, para travar contra interceptação; aparece na primeira conexão
RH_SSH_HOST_FINGERPRINT=
# o MySQL, visto de dentro da VPS (normalmente 127.0.0.1:3306)
RH_MYSQL_HOST=127.0.0.1
RH_MYSQL_PORT=3306
RH_MYSQL_DATABASE=impera_rh
RH_MYSQL_USER=
RH_MYSQL_PASSWORD=

# RH: pasta das fotos e documentos (NF, comprovantes). Fora do Git; inclua no backup. Limite por arquivo em bytes (padrão 10 MB).
RH_STORAGE_DIR=./storage/rh
RH_DOC_MAX_BYTES=10485760
