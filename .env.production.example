# Modelo para publicar a API (frontend na Vercel + API na sua máquina atrás de um túnel HTTPS).
# SEM domínio próprio (Tailscale Funnel + rewrite /api da Vercel): COOKIE_DOMAIN vazio, TRUST_PROXY=2 e
# CORS_ORIGINS=https://SEU-APP.vercel.app. Veja financeiro-impera-web/docs/PUBLICAR.md.
# Copie para .env e preencha. NUNCA versione o .env com valores reais.

NODE_ENV=production
PORT=3000
# O túnel (Cloudflare) fica na frente da API: confie em 1 proxy para o IP real no rate limit
TRUST_PROXY=1
# Somente o frontend publicado (sem "*")
CORS_ORIGINS=https://app.imperafinanceiro.com
# /docs só para ADMIN autenticado
SWAGGER_ENABLED=false

# Cookies: frontend e API no MESMO site (app.* e api.*) => SameSite=lax funciona e o cookie csrf é legível pelo SPA
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.imperafinanceiro.com

# Gere um novo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Banco: use um PostgreSQL de verdade (não o embutido de desenvolvimento)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/financeiro?schema=public

# Integrações (continuam só no servidor)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/<arquivo>.json
# GOOGLE_SHEET_ID=
# REDTRACK_API_KEY=
# REDTRACK_BASE_URL=https://api.redtrack.io
SYNC_ENABLED=true

# ── E-mail transacional (recuperação de senha, convites, alertas) ──
# Sem SMTP em produção, "Esqueci minha senha" fica desativado (o login continua normal) e novos usuários são criados com senha temporária.
# Link enviado por e-mail aponta para este endereço (o do frontend publicado):
APP_PUBLIC_URL=https://SEU-APP.vercel.app
MAIL_TRANSPORT=smtp
MAIL_FROM="Financeiro Impera <no-reply@seudominio.com>"
# Exemplos: Gmail (senha de app, 2FA ligado) smtp.gmail.com:587 · Resend smtp.resend.com:465 (SMTP_SECURE=true) · Amazon SES · Zoho
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Políticas de conta (valores padrão)
RESET_TOKEN_TTL_MINUTES=30
INVITE_TOKEN_TTL_HOURS=72
FORGOT_PASSWORD_MAX_PER_HOUR=3
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_HISTORY=5

# ── Sincronização automática (roda dentro da API, sem processo separado) ──
# A cada N minutos: EVENTOS + REDTRACK incremental; na subida, se estiver velha; reconciliação completa diária em SYNC_RECONCILE_TIME.
# Para usar o worker separado (npm run start:worker), desligue aqui para não sincronizar em dobro.
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=60

# Desempenho e limites (opcionais; valores padrão entre parênteses)
# Tentativas de login falhas por IP (teto contra varredura; o limite principal é por e-mail): 200
RATE_LIMIT_LOGIN_IP_MAX=200
# Conexões simultâneas com o banco: 10
DB_POOL_MAX=10
# Tempo máximo de uma consulta, em ms: 60000
DB_STATEMENT_TIMEOUT_MS=60000
