# Modelo para publicar a API (frontend na Vercel + API na sua máquina atrás de um túnel HTTPS).
# SEM domínio próprio (Tailscale Funnel + rewrite /api da Vercel): COOKIE_DOMAIN vazio, TRUST_PROXY=2 e
# CORS_ORIGINS=https://SEU-APP.vercel.app. Veja financeiro-impera-web/docs/PUBLICAR.md.
# Copie para .env e preencha. NUNCA versione o .env com valores reais.

NODE_ENV=production
PORT=3000
# O túnel (Cloudflare) fica na frente da API: confie em 1 proxy para o IP real no rate limit
TRUST_PROXY=1
# Somente o frontend publicado (sem "*")
CORS_ORIGINS=https://app.imperafinanceiro.com
# /docs só para ADMIN autenticado
SWAGGER_ENABLED=false

# Cookies: frontend e API no MESMO site (app.* e api.*) => SameSite=lax funciona e o cookie csrf é legível pelo SPA
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.imperafinanceiro.com

# Gere um novo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Banco: use um PostgreSQL de verdade (não o embutido de desenvolvimento)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/financeiro?schema=public

# Integrações (continuam só no servidor)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/<arquivo>.json
# GOOGLE_SHEET_ID=
# REDTRACK_API_KEY=
# REDTRACK_BASE_URL=https://api.redtrack.io
SYNC_ENABLED=true
