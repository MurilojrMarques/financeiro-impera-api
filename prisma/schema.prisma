// Valores monetários: SEMPRE em centavos inteiros (Int/BigInt). Nunca float.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoGrupo {
  FRONT
  BACKEND_OUTROS
  CALL_CENTER
  RECUPERACAO
  AFILIADO
  NAO_CLASSIFICADA
}

enum StatusVenda {
  PAGO
  ESTORNADO
  CHARGEBACK
  PENDENTE_CONCILIACAO
}

enum TipoVenda {
  FRONT
  UPSELL
  DOWNSELL
  CALL_CENTER
  OUTRO
}

enum TipoEvento {
  PAGAMENTO
  ESTORNO
  CHARGEBACK
}

enum FonteComissao {
  HISTORICO_EXATA
  PAGAH
  ESTIMADA
  REDTRACK
  REGRA_AFILIADO
  AUSENTE
}

enum FonteDadoTipo {
  HISTORICO
  EVENTOS
  REDTRACK
}

enum PerfilUsuario {
  ADMIN
  FINANCEIRO
  ANALISTA
  LEITURA
  /// sem acesso a nenhuma tela financeira (colaboradores comuns, só RH): fica fora de todos os grupos de rotas do financeiro
  SEM_FINANCEIRO
}

/// Papel no módulo de RH (independente do perfil financeiro: uma pessoa pode ser FINANCEIRO e RH ao mesmo tempo).
enum RhPapel {
  RH
  CEO
  GESTOR
  COLABORADOR
}

enum StatusSincronizacao {
  EXECUTANDO
  SUCESSO
  PARCIAL
  FALHA
}

enum StatusPagamentoCusto {
  PENDENTE
  PAGO
  CANCELADO
}

enum PeriodicidadeCusto {
  SEMANAL
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum TipoRegraCusto {
  PERCENTUAL_RECEITA
  VALOR_POR_PEDIDO
  VALOR_POR_UNIDADE
  VALOR_FIXO_PERIODO
}

enum CampoClassificacao {
  ORIGEM
  TIPO_ATENDIMENTO
  LOJA
  CAMPANHA
  UTM_SOURCE
  SRC
  CHECKOUT
}

enum OperadorClassificacao {
  IGUAL
  CONTEM
  COMECA_COM
}

// ───────────── Autenticação ─────────────

model Usuario {
  id               String             @id @default(uuid()) @db.Uuid
  /// ao menos um entre e-mail e usuário é obrigatório (CHECK no banco); o login aceita qualquer um dos dois
  email            String?            @unique
  /// nome de usuário para login (minúsculas, 3–32 caracteres: letras, números, ponto, hífen e sublinhado)
  usuario          String?            @unique
  nome             String
  senhaHash        String
  perfil           PerfilUsuario
  ativo            Boolean            @default(true)
  trocaSenhaObrig  Boolean            @default(false)
  /// papel no RH (null = sem acesso ao módulo de RH) e o colaborador a que este login pertence
  rhPapel          RhPapel?
  colaboradorId    String?            @unique @db.Uuid
  colaborador      RhColaborador?     @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  /// convite enviado e ainda não aceito: a senha gravada é aleatória e inutilizável
  convitePendente  Boolean            @default(false)
  /// tentativas de login falhas consecutivas e bloqueio temporário (anti força-bruta)
  falhasLogin      Int                @default(0)
  bloqueadoAte     DateTime?          @db.Timestamptz
  senhaAlteradaEm  DateTime?          @db.Timestamptz
  ultimoLoginEm    DateTime?          @db.Timestamptz
  criadoEm         DateTime           @default(now()) @db.Timestamptz
  atualizadoEm     DateTime           @updatedAt @db.Timestamptz
  sessoes          Sessao[]
  tokens           TokenUsuario[]
  senhasAnteriores SenhaHistorico[]
  auditorias       Auditoria[]
  custos           CustoOperacional[]

  @@map("usuarios")
}

enum TipoTokenUsuario {
  RESET_SENHA
  CONVITE
}

/// Token de uso único para redefinir a senha ou aceitar um convite. Só o HASH (SHA-256) é armazenado.
model TokenUsuario {
  id         String           @id @default(uuid()) @db.Uuid
  usuarioId  String           @db.Uuid
  tipo       TipoTokenUsuario
  tokenHash  String           @unique
  expiraEm   DateTime         @db.Timestamptz
  usadoEm    DateTime?        @db.Timestamptz
  revogadoEm DateTime?        @db.Timestamptz
  ip         String?
  userAgent  String?
  criadoEm   DateTime         @default(now()) @db.Timestamptz
  usuario    Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo, usadoEm, revogadoEm])
  @@index([criadoEm])
  @@map("tokens_usuario")
}

/// Hashes das senhas anteriores (impede reaproveitar as últimas N).
model SenhaHistorico {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  senhaHash String
  criadoEm  DateTime @default(now()) @db.Timestamptz
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("senhas_historico")
}

// Sessão = família de refresh tokens. Armazena somente o HASH do token atual.
model Sessao {
  id              String    @id @default(uuid()) @db.Uuid
  usuarioId       String    @db.Uuid
  refreshHash     String    @unique
  refreshAnterior String? // hash do token rotacionado (detecção de reuso)
  expiraEm        DateTime  @db.Timestamptz
  revogadaEm      DateTime? @db.Timestamptz
  ip              String?
  userAgent       String?
  criadoEm        DateTime  @default(now()) @db.Timestamptz
  ultimoUsoEm     DateTime  @default(now()) @db.Timestamptz
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revogadaEm])
  @@index([refreshAnterior])
  @@map("sessoes")
}

model Auditoria {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @db.Uuid
  acao       String
  entidade   String?
  entidadeId String?
  detalhes   Json?
  ip         String?
  criadoEm   DateTime @default(now()) @db.Timestamptz
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@index([usuarioId])
  @@index([acao])
  @@map("auditoria")
}

// ───────────── Integração ─────────────

model FonteDados {
  id                 String        @id @default(uuid()) @db.Uuid
  tipo               FonteDadoTipo @unique
  nomeAba            String
  cabecalhos         Json? // últimos cabeçalhos reais lidos
  cabecalhosAusentes Json?
  intervaloSegundos  Int
  ativa              Boolean       @default(true)
  ultimaLeituraEm    DateTime?     @db.Timestamptz
  ultimoSucessoEm    DateTime?     @db.Timestamptz
  estado             String        @default("NUNCA_SINCRONIZADA")
  ultimoErro         String?
  atualizadoEm       DateTime      @updatedAt @db.Timestamptz

  @@map("fontes_dados")
}

model Sincronizacao {
  id           String              @id @default(uuid()) @db.Uuid
  fonte        FonteDadoTipo
  modo         String // INCREMENTAL | COMPLETA | INICIAL
  status       StatusSincronizacao @default(EXECUTANDO)
  iniciadaEm   DateTime            @default(now()) @db.Timestamptz
  finalizadaEm DateTime?           @db.Timestamptz
  duracaoMs    Int?
  lidos        Int                 @default(0)
  inseridos    Int                 @default(0)
  atualizados  Int                 @default(0)
  ignorados    Int                 @default(0)
  comErro      Int                 @default(0)
  erro         String?
  disparadaPor String              @default("worker")
  erros        ErroImportacao[]

  @@index([fonte, iniciadaEm])
  @@index([status])
  @@map("sincronizacoes")
}

// Cursor = quantas linhas de DADOS (excluindo cabeçalho) já foram persistidas.
// A posição é só otimização de leitura; a identidade vem das chaves determinísticas.
model SincronizacaoCursor {
  fonte         FonteDadoTipo @id
  ultimaLinha   Int           @default(0)
  assinaturaCab String?
  atualizadoEm  DateTime      @updatedAt @db.Timestamptz

  @@map("sincronizacao_cursor")
}

model RegistroImportado {
  id           String        @id @default(uuid()) @db.Uuid
  fonte        FonteDadoTipo
  chave        String // chave determinística da linha
  hash         String // hash normalizado do conteúdo
  linhaOrigem  Int
  importadoEm  DateTime      @default(now()) @db.Timestamptz
  atualizadoEm DateTime      @updatedAt @db.Timestamptz

  @@unique([fonte, chave])
  @@map("registros_importados")
}

model ErroImportacao {
  id              String         @id @default(uuid()) @db.Uuid
  sincronizacaoId String?        @db.Uuid
  fonte           FonteDadoTipo
  linhaOrigem     Int?
  codigo          String
  mensagem        String // sanitizada, sem dados sensíveis
  campo           String?
  criadoEm        DateTime       @default(now()) @db.Timestamptz
  sincronizacao   Sincronizacao? @relation(fields: [sincronizacaoId], references: [id], onDelete: SetNull)

  @@index([fonte, criadoEm])
  @@map("erros_importacao")
}

// ───────────── Vendas ─────────────

model Loja {
  id     String  @id @default(uuid()) @db.Uuid
  nome   String  @unique
  vendas Venda[]

  @@map("lojas")
}

model Produto {
  id       String         @id @default(uuid()) @db.Uuid
  nome     String         @unique
  downsell Boolean        @default(false)
  vendas   Venda[]
  itens    VendaProduto[]

  @@map("produtos")
}

model Afiliado {
  id        String                  @id @default(uuid()) @db.Uuid
  nome      String // nome canônico (original)
  nomeBusca String                  @unique // minúsculo, sem acento, espaços colapsados
  criadoEm  DateTime                @default(now()) @db.Timestamptz
  aliases   AfiliadoAlias[]
  regras    RegraComissaoAfiliado[]
  vendas    Venda[]

  @@map("afiliados")
}

model AfiliadoAlias {
  id         String   @id @default(uuid()) @db.Uuid
  afiliadoId String   @db.Uuid
  alias      String
  aliasBusca String   @unique
  criadoEm   DateTime @default(now()) @db.Timestamptz
  afiliado   Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@index([afiliadoId])
  @@map("afiliado_aliases")
}

model RegraComissaoAfiliado {
  id                String    @id @default(uuid()) @db.Uuid
  afiliadoId        String    @db.Uuid
  valorFixoCentavos Int?
  percentualBps     Int? // pontos-base (1% = 100)
  vigenteDe         DateTime  @db.Timestamptz
  vigenteAte        DateTime? @db.Timestamptz
  fonte             String // origem da regra (contrato, planilha, etc.)
  observacao        String?
  criadoPorId       String?   @db.Uuid
  criadoEm          DateTime  @default(now()) @db.Timestamptz
  afiliado          Afiliado  @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@index([afiliadoId, vigenteDe])
  @@map("regras_comissao_afiliado")
}

model RegraClassificacao {
  id           String                @id @default(uuid()) @db.Uuid
  nome         String
  campo        CampoClassificacao
  operador     OperadorClassificacao
  valor        String
  grupo        TipoGrupo
  canal        String? // ex.: SMS, EMAIL (rótulo livre, só da regra)
  prioridade   Int                   @default(100)
  ativa        Boolean               @default(true)
  versao       Int                   @default(1)
  criadoPorId  String?               @db.Uuid
  criadoEm     DateTime              @default(now()) @db.Timestamptz
  atualizadoEm DateTime              @updatedAt @db.Timestamptz

  @@index([ativa, prioridade])
  @@map("regras_classificacao")
}

model Venda {
  id                       String        @id @default(uuid()) @db.Uuid
  pedido                   String        @unique
  lojaId                   String?       @db.Uuid
  produtoId                String?       @db.Uuid
  afiliadoId               String?       @db.Uuid
  afiliadoNomeOriginal     String?
  grupo                    TipoGrupo
  tipoVenda                TipoVenda
  tipoBruto                String? // valor original da coluna tipo (permite reclassificar)
  status                   StatusVenda
  origem                   String?
  tipoAtendimento          String?
  atendente                String?
  checkout                 String?
  kitNome                  String?
  metodoPagamento          String?
  parcelas                 Int?
  valorTotalCentavos       Int? // pode incluir juros
  valorVendaCentavos       Int // valor_sem_juros (base de faturamento)
  jurosCentavos            Int?
  valorLiquidoCentavos     Int?
  comissaoCentavos         Int? // null = ausente (diferente de 0)
  comissaoFonte            FonteComissao @default(AUSENTE)
  taxaCallCenterCentavos   Int?
  // Comissão do AFILIADO (distinta da comissão da operação, que é o que a Impera recebe)
  comissaoAfiliadoCentavos Int?
  comissaoAfiliadoFonte    FonteComissao @default(AUSENTE)
  vendedorId               String? // id_user_venda do webhook (operador/vendedor); sem dados pessoais
  canalPlanilha            String? // coluna `canal` do EVENTOS (front, call center, recuperação de vendas, back end, afiliado): quem fechou a venda
  subcanal                 String? // detalhe do canal: compra/upsell/downsell no front, o vendedor no call center/recuperação, SMS/e-mail/disparo no back end
  origemLead               String? // quando o vendedor fecha lead de SMS, e-mail ou disparo
  clienteHash              String? // sha256 do cliente_id (EVENTOS): só permite agrupar pedidos do mesmo cliente (frete); nunca o id original
  x1                       Boolean       @default(false)
  campanha                 String?
  anuncio                  String?
  clickId                  String?
  utmSource                String?
  utmCampaign              String?
  utmContent               String?
  src                      String?
  pagoEm                   DateTime?     @db.Timestamptz
  criadoEmOrigem           DateTime?     @db.Timestamptz
  estornadoEm              DateTime?     @db.Timestamptz
  chargebackEm             DateTime?     @db.Timestamptz
  perdaCentavos            Int           @default(0) // perda (integral ou soma de parciais) contada UMA vez
  perdaEm                  DateTime?     @db.Timestamptz // data do evento que estabeleceu a perda (a mais antiga)
  perdaTipo                TipoEvento? // ESTORNO ou CHARGEBACK: tipo do evento mais antigo
  classificacaoMotivo      String? // auditoria: por que caiu neste grupo
  classificacaoRegraId     String?       @db.Uuid
  avisos                   String[]      @default([]) // limitações de conciliação (ex.: valor de evento ausente)
  fonteVerdade             FonteDadoTipo
  redtrackConciliado       Boolean       @default(false)
  hashConteudo             String
  sincronizadoEm           DateTime      @default(now()) @db.Timestamptz
  criadoEm                 DateTime      @default(now()) @db.Timestamptz
  atualizadoEm             DateTime      @updatedAt @db.Timestamptz

  loja     Loja?              @relation(fields: [lojaId], references: [id])
  produto  Produto?           @relation(fields: [produtoId], references: [id])
  afiliado Afiliado?          @relation(fields: [afiliadoId], references: [id])
  eventos  VendaEvento[]
  itens    VendaProduto[]
  redtrack RedtrackConversao?

  @@index([status])
  @@index([pagoEm])
  @@index([estornadoEm])
  @@index([chargebackEm])
  @@index([lojaId])
  @@index([afiliadoId])
  @@index([grupo])
  @@index([origem])
  @@index([metodoPagamento])
  @@index([campanha])
  @@index([sincronizadoEm])
  @@index([grupo, pagoEm])
  @@index([clienteHash])
  @@index([canalPlanilha])
  @@index([perdaEm])
  @@map("vendas")
}

model VendaEvento {
  id               String        @id @default(uuid()) @db.Uuid
  vendaId          String        @db.Uuid
  eventKey         String        @unique // determinística, ver docs/IDENTIDADE.md
  tipo             TipoEvento
  fonte            FonteDadoTipo
  ocorridoEm       DateTime?     @db.Timestamptz
  recebidoEm       DateTime?     @db.Timestamptz
  valorCentavos    Int?
  comissaoCentavos Int?
  linhaOrigem      Int?
  hashConteudo     String
  criadoEm         DateTime      @default(now()) @db.Timestamptz
  venda            Venda         @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([vendaId])
  @@index([tipo, ocorridoEm])
  @@map("venda_eventos")
}

// Só populada se a planilha trouxer detalhamento por item.
model VendaProduto {
  id         String  @id @default(uuid()) @db.Uuid
  vendaId    String  @db.Uuid
  produtoId  String  @db.Uuid
  quantidade Int?
  venda      Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id])

  @@unique([vendaId, produtoId])
  @@map("venda_produtos")
}

model RedtrackConversao {
  id             String   @id @default(uuid()) @db.Uuid
  pedido         String   @unique
  vendaId        String?  @unique @db.Uuid
  conversaoId    String?
  payoutCentavos Int?
  situacao       String?
  campanha       String?
  anuncio        String?
  hashConteudo   String
  linhaOrigem    Int?
  sincronizadoEm DateTime @default(now()) @db.Timestamptz
  venda          Venda?   @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  @@index([campanha])
  @@index([situacao])
  @@map("redtrack_conversoes")
}

// ───────────── Financeiro ─────────────

model CategoriaCusto {
  id     String             @id @default(uuid()) @db.Uuid
  nome   String             @unique
  ativa  Boolean            @default(true)
  custos CustoOperacional[]
  regras RegraCusto[]

  @@map("categorias_custo")
}

model RecorrenciaCusto {
  id            String             @id @default(uuid()) @db.Uuid
  periodicidade PeriodicidadeCusto
  inicio        DateTime           @db.Date
  fim           DateTime?          @db.Date
  custos        CustoOperacional[]

  @@map("recorrencias_custo")
}

model CustoOperacional {
  id              String               @id @default(uuid()) @db.Uuid
  descricao       String
  tipo            String // FIXO | VARIAVEL
  categoriaId     String               @db.Uuid
  recorrenciaId   String?              @db.Uuid
  grupo           TipoGrupo? // grupo de receita ao qual o custo se atribui
  valorCentavos   Int
  vencimento      DateTime             @db.Date
  statusPagamento StatusPagamentoCusto @default(PENDENTE)
  observacao      String?
  responsavelId   String?              @db.Uuid
  criadoEm        DateTime             @default(now()) @db.Timestamptz
  atualizadoEm    DateTime             @updatedAt @db.Timestamptz
  categoria       CategoriaCusto       @relation(fields: [categoriaId], references: [id])
  recorrencia     RecorrenciaCusto?    @relation(fields: [recorrenciaId], references: [id])
  responsavel     Usuario?             @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  anexos          AnexoCusto[]

  @@index([vencimento])
  @@index([categoriaId])
  @@index([grupo])
  @@map("custos_operacionais")
}

model AnexoCusto {
  id           String           @id @default(uuid()) @db.Uuid
  custoId      String           @db.Uuid
  nomeOriginal String
  mime         String
  tamanhoBytes Int
  caminho      String // caminho relativo em storage privado
  criadoEm     DateTime         @default(now()) @db.Timestamptz
  custo        CustoOperacional @relation(fields: [custoId], references: [id], onDelete: Cascade)

  @@index([custoId])
  @@map("anexos_custo")
}

model RegraCusto {
  id            String          @id @default(uuid()) @db.Uuid
  nome          String
  tipo          TipoRegraCusto
  grupo         TipoGrupo? // null = todos os grupos
  categoriaId   String?         @db.Uuid
  valorCentavos Int? // para VALOR_*
  percentualBps Int? // para PERCENTUAL_RECEITA (1% = 100)
  vigenteDe     DateTime        @db.Timestamptz
  vigenteAte    DateTime?       @db.Timestamptz
  metodologia   String
  ativa         Boolean         @default(true)
  criadoEm      DateTime        @default(now()) @db.Timestamptz
  atualizadoEm  DateTime        @updatedAt @db.Timestamptz
  categoria     CategoriaCusto? @relation(fields: [categoriaId], references: [id])

  @@index([ativa, vigenteDe])
  @@map("regras_custo")
}

model ConfiguracaoFinanceira {
  chave        String   @id
  valor        Json
  atualizadoEm DateTime @updatedAt @db.Timestamptz

  @@map("configuracoes_financeiras")
}

// ───────────────────────────── RH (colaboradores PJ, salários) ─────────────────────────────
// Origem: sistema de RH atual (MySQL impera_rh · app_state). Importação repetível e somente leitura: `npm run rh:importar`.
// Dados pessoais e SALÁRIOS: acesso restrito (RH e CEO veem salário); toda consulta a salário é auditada.

enum RhTipoMovimentacao {
  PROMOCAO
  REAJUSTE
}

model RhColaborador {
  id              String    @id @default(uuid()) @db.Uuid
  /// id do colaborador no sistema de RH atual (chave da importação)
  legadoId        String?   @unique
  nome            String
  email           String?
  celular         String?
  nascimento      DateTime? @db.Date
  /// CNPJ do colaborador (todos são PJ)
  cnpj            String?
  endereco        String?
  camiseta        String?
  departamento    String
  cargoBase       String?
  /// título completo (ex.: "Editor Pl", "Líder de Copy")
  funcao          String?
  tipoCargo       String?
  senioridade     String?
  subnivel        Int?
  gestorId        String?   @db.Uuid
  inicio          DateTime? @db.Date
  demissao        DateTime? @db.Date
  motivoDemissao  String?
  /// campo "contrato" do sistema atual: não é o tipo (todos são PJ), é uma anotação sobre o contrato (ex.: ok, falta)
  contratoObs     String?
  /// salário mensal atual, em centavos
  salarioCentavos Int
  descricao       String?
  obsCargo        String?
  discordUserId   String?
  /// id do copywriter no sistema de copy (comissionamento): liga a comissão do Front a esta pessoa; definido pelo RH, a origem do RH não mexe
  copywriterId    String?   @unique @db.Uuid
  imperaCreds     RhImperaCred[]
  /// chave PIX para o pagamento (CPF, CNPJ, e-mail, celular ou chave aleatória): não vem do sistema do RH, é mantida aqui pelo RH
  pix             String?
  /// chave do beneficiário da comissão que não é copywriter (GESTOR:GREG, EDITOR:MINEIRO, FIXO:IAGO): definido pelo RH
  comissaoChave   String?   @unique
  /// foto guardada como arquivo (não mais base64 dentro do banco)
  fotoArquivo     String?
  /// SHA-256 da foto na origem: só regrava o arquivo quando ela muda
  fotoHash        String?
  criadoEm        DateTime  @default(now()) @db.Timestamptz
  atualizadoEm    DateTime  @updatedAt @db.Timestamptz

  gestor        RhColaborador?   @relation("GestorEquipe", fields: [gestorId], references: [id], onDelete: SetNull)
  equipe        RhColaborador[]  @relation("GestorEquipe")
  movimentacoes RhMovimentacao[]
  usuario       Usuario?
  rhDocumentos  RhDocumento[]
  rhFolhaItems  RhFolhaItem[]

  @@index([departamento])
  @@index([gestorId])
  @@index([demissao])
  @@map("rh_colaboradores")
}

/// Histórico de promoções e reajustes (cargo e salário ao longo do tempo).
model RhMovimentacao {
  id                      String             @id @default(uuid()) @db.Uuid
  legadoId                String?            @unique
  colaboradorId           String             @db.Uuid
  tipo                    RhTipoMovimentacao
  data                    DateTime           @db.Date
  cargoAnterior           String?
  cargoNovo               String?
  departamentoAnterior    String?
  departamentoNovo        String?
  senioridadeAnterior     String?
  senioridadeNova         String?
  subnivelAnterior        Int?
  subnivelNovo            Int?
  salarioAnteriorCentavos Int
  salarioNovoCentavos     Int
  obs                     String?
  criadoEm                DateTime           @default(now()) @db.Timestamptz

  colaborador RhColaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, data])
  @@map("rh_movimentacoes")
}

/// Matriz de cargos e salários: faixa por departamento, cargo e nível (jr, pl, sr, jrSub2, srTopo...).
model RhFaixaSalarial {
  id            String   @id @default(uuid()) @db.Uuid
  departamento  String
  cargo         String
  nivel         String
  valorCentavos Int
  atualizadoEm  DateTime @updatedAt @db.Timestamptz

  @@unique([departamento, cargo, nivel])
  @@map("rh_faixas_salariais")
}

/// Usuários do sistema de RH atual (sem senha): só para ligar, depois, cada login ao colaborador e ao papel.
model RhUsuarioLegado {
  id            String   @id @default(uuid()) @db.Uuid
  legadoId      Int      @unique
  username      String
  email         String?
  papel         String
  departamento  String?
  colaboradorId String?  @db.Uuid
  criadoEm      DateTime @default(now()) @db.Timestamptz

  @@map("rh_usuarios_legado")
}

enum RhTipoDocumento {
  NOTA_FISCAL
  COMPROVANTE_PAGAMENTO
  CONTRATO
  OUTRO
}

enum RhStatusDocumento {
  ENVIADO
  APROVADO
  REPROVADO
}

/// NF enviada pelo colaborador, comprovante de pagamento, contrato etc. O arquivo fica em disco (fora do Git); aqui só o registro.
model RhDocumento {
  id               String            @id @default(uuid()) @db.Uuid
  colaboradorId    String            @db.Uuid
  tipo             RhTipoDocumento
  /// mês de referência (AAAA-MM), quando se aplica (NF e comprovante do mês)
  competencia      String?
  valorCentavos    Int?
  descricao        String?
  arquivoNome      String
  arquivoCaminho   String
  mime             String
  tamanhoBytes     Int
  sha256           String
  status           RhStatusDocumento @default(ENVIADO)
  motivoReprovacao String?
  enviadoPorId     String?           @db.Uuid
  revisadoPorId    String?           @db.Uuid
  revisadoEm       DateTime?         @db.Timestamptz
  criadoEm         DateTime          @default(now()) @db.Timestamptz

  colaborador RhColaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, competencia])
  @@index([tipo, status])
  @@map("rh_documentos")
}

enum RhStatusFolha {
  ABERTA
  FECHADA
}

enum RhStatusPagamento {
  PENDENTE
  PAGO
}

/// Folha de um mês (AAAA-MM): o que a Impera paga aos colaboradores PJ.
model RhFolhaCompetencia {
  id           String        @id @default(uuid()) @db.Uuid
  competencia  String        @unique
  status       RhStatusFolha @default(ABERTA)
  fechadaEm    DateTime?     @db.Timestamptz
  fechadaPorId String?       @db.Uuid
  criadoEm     DateTime      @default(now()) @db.Timestamptz
  itens        RhFolhaItem[]

  @@map("rh_folha_competencias")
}

model RhFolhaItem {
  id                    String            @id @default(uuid()) @db.Uuid
  competenciaId         String            @db.Uuid
  colaboradorId         String            @db.Uuid
  /// salário vigente no mês (pelo histórico de reajustes)
  /// salário mensal cheio (referência) e dias trabalhados no mês (mês comercial de 30 dias; entrada/saída no meio do mês = proporcional)
  salarioMensalCentavos Int               @default(0)
  diasTrabalhados       Int               @default(30)
  /// valor do salário a pagar no mês = salarioMensal ÷ 30 × diasTrabalhados
  salarioCentavos       Int
  comissaoCentavos      Int               @default(0)
  bonusCentavos         Int               @default(0)
  descontoCentavos      Int               @default(0)
  /// ImperaCred (adiantamento de salário) do mês anterior, descontado aqui; vem de rh_impera_cred, não se edita direto
  imperaCredCentavos    Int               @default(0)
  /// salário + comissão + bônus − desconto − ImperaCred
  totalCentavos         Int
  status                RhStatusPagamento @default(PENDENTE)
  pagoEm                DateTime?         @db.Date
  obs                   String?
  atualizadoEm          DateTime          @updatedAt @db.Timestamptz

  competencia RhFolhaCompetencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  colaborador RhColaborador      @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)

  @@unique([competenciaId, colaboradorId])
  @@index([colaboradorId])
  @@map("rh_folha_itens")
}

enum RhStatusSincronizacao {
  SUCESSO
  ERRO
}

enum RhTipoAlteracao {
  NOVO_COLABORADOR
  SALARIO
  CARGO
  DEPARTAMENTO
  GESTOR
  DESLIGAMENTO
  MOVIMENTACAO
  REMOVIDO_DA_ORIGEM
}

/// Uma leitura do sistema de RH de origem (MySQL do Alexandre). A API NUNCA grava lá e NUNCA altera salário aqui: só espelha e monitora.
model RhSincronizacao {
  id                   String                @id @default(uuid()) @db.Uuid
  iniciadaEm           DateTime              @default(now()) @db.Timestamptz
  concluidaEm          DateTime?             @db.Timestamptz
  status               RhStatusSincronizacao
  /// job (automática), manual (botão/endpoint) ou script
  gatilho              String
  origemAtualizadaEm   DateTime?             @db.Timestamptz
  origemAtualizadaPor  String?
  lidos                Int                   @default(0)
  novos                Int                   @default(0)
  atualizados          Int                   @default(0)
  alteracoes           Int                   @default(0)
  inconsistencias      Int                   @default(0)
  erro                 String?
  detalhes             Json?
  alteracoesDetectadas RhAlteracao[]

  @@index([iniciadaEm])
  @@map("rh_sincronizacoes")
}

/// Mudança detectada na origem entre duas leituras (salário, cargo, departamento, gestor, desligamento, promoção/reajuste, novo colaborador).
model RhAlteracao {
  id              String          @id @default(uuid()) @db.Uuid
  sincronizacaoId String          @db.Uuid
  colaboradorId   String?         @db.Uuid
  tipo            RhTipoAlteracao
  campo           String?
  /// valores como texto; salário em centavos
  anterior        String?
  novo            String?
  detectadaEm     DateTime        @default(now()) @db.Timestamptz

  sincronizacao RhSincronizacao @relation(fields: [sincronizacaoId], references: [id], onDelete: Cascade)

  @@index([detectadaEm])
  @@index([colaboradorId, detectadaEm])
  @@index([tipo, detectadaEm])
  @@map("rh_alteracoes")
}

/// Cadastro das VSLs da comissão por VSL (a chave vem do nome da landing: nicho + oferta + produto + vslNN). Dono e editor são decisão do negócio
/// (ClickUp + Elias), não estão no RedTrack. `mesmaVsl`: esta chave se junta a outra (oferta cadastrada com número ou nicho errado).
model ComissaoVsl {
  id           String   @id @default(uuid()) @db.Uuid
  chave        String   @unique
  /// apelido do copywriter dono da VSL (YAN, ELIAS...); EMPRESA = não comissiona
  dono         String?
  /// quem editou a 1ª versão (MINEIRO...); RIPAGEM e SEM VSL não têm editor
  editor       String?
  mesmaVsl     String?
  fonte        String?
  atualizadoEm DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("comissao_vsl")
}

/// Otimização validada (lead ou MLD que o time validou): vale R$ 500 para o copywriter, lançada pelo RH no mês da competência.
model ComissaoOtimizacao {
  id            String   @id @default(uuid()) @db.Uuid
  competencia   String
  /// apelido do copywriter no sistema de copy (YAN, CAROL...)
  copywriter    String
  descricao     String
  valorCentavos Int      @default(50000)
  criadoPorId   String?  @db.Uuid
  criadoEm      DateTime @default(now()) @db.Timestamptz

  @@index([competencia])
  @@map("comissao_otimizacoes")
}

/// ImperaCred: adiantamento de salário feito no mês `competencia` e descontado, inteiro, da folha do mês seguinte
/// (recebe 5.000, adianta 2.500 em outubro => em novembro recebe 2.500). O RH lança; a folha do mês seguinte soma sozinha.
model RhImperaCred {
  id            String        @id @default(uuid()) @db.Uuid
  colaboradorId String        @db.Uuid
  /// mês (AAAA-MM) em que o adiantamento foi feito
  competencia   String
  valorCentavos Int
  observacao    String?
  criadoPorId   String?       @db.Uuid
  criadoEm      DateTime      @default(now()) @db.Timestamptz
  colaborador   RhColaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)

  @@index([competencia])
  @@index([colaboradorId, competencia])
  @@map("rh_impera_cred")
}
